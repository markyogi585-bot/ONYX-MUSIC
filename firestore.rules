rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidCloudMusicItem(data, expectedUserId) {
      let requiredFields = ['userId', 'songId', 'title', 'artist', 'category', 'createdAt'];
      let allowedFields = ['userId', 'songId', 'title', 'artist', 'category', 'createdAt'];

      return data.keys().hasAll(requiredFields)
        && data.keys().hasOnly(allowedFields)
        && data.userId is string && data.userId == expectedUserId
        && data.songId is string && data.songId.size() >= 1 && data.songId.size() <= 128
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.artist is string && data.artist.size() >= 1 && data.artist.size() <= 200
        && data.category is string && data.category in ['favorite', 'mood', 'ai_playlist']
        && data.createdAt is timestamp && data.createdAt <= request.time;
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /users/{userId}/cloud_items/{itemId} {
      allow read: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && isValidId(itemId)
        && isValidCloudMusicItem(request.resource.data, userId);

      allow update: if isSignedIn()
        && request.auth.uid == userId
        && isValidId(itemId)
        && isValidCloudMusicItem(request.resource.data, userId)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
